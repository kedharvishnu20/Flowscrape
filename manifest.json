{
  "manifest_version": 3,
  "name": "FlowScrape v3",
  "version": "3.0.0",
  "description": "Visual web automation and data extraction: build a pipeline of steps, run it against a tab, export the results.",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "sidePanel",
    "proxy",
    "tabs",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "FlowScrape v3",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/form-filler.js",
        "content/overlay-engine.js",
        "content/overlay-renderer.js",
        "utils/color-utils.js",
        "utils/logger.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
